{% from '_macros.html.j2' import header, lines, box, footer, cover_page %}
{{ cover_page(style, page, content.title, content.subtitle, content.tagline, [content.days|length ~ ' guided days', 'Weekly check-ins', 'Printable']) }}

<section class="page">
  {{ header(style, 'Before you begin', content.title) }}
  <p style="font-size:1.05em;max-width:34em;">{{ content.welcome }}</p>
  <div style="margin-top:1em;">
    {% for step in content.how_to %}
    <div style="display:flex;margin-bottom:.8em;align-items:flex-start;">
      <div style="flex:none;width:1.9em;height:1.9em;border-radius:50%;background:var(--accent);color:var(--accent-ink);text-align:center;line-height:1.9em;font-weight:700;margin-right:.7em;">{{ loop.index }}</div>
      <div style="padding-top:.2em;">{{ step }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="fill" style="margin-top:.6em;">{{ box('How I feel starting today', 8, 'soft') }}</div>
  {{ footer(content.title) }}
</section>

{% for day in content.days %}
<section class="page">
  {{ header(style, 'Day ' ~ loop.index, day.theme) }}
  <div class="card soft" style="margin-bottom:.8em;">
    <div class="label">Today's prompt</div>
    <div class="h" style="font-size:1.35em;line-height:1.25;">{{ day.prompt }}</div>
    {% if day.nudge %}<div class="small muted" style="margin-top:.5em;">{{ day.nudge }}</div>{% endif %}
  </div>
  <div class="card" style="flex:1;"><div class="label">Write here</div>{{ lines(14) }}</div>
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:.7em;margin-top:.8em;height:6.5em;">
    {{ box('Grateful for', 3) }}{{ box('One small step', 3) }}
    <div class="card"><div class="label">Mood</div>
      <div style="display:flex;justify-content:space-between;margin-top:.5em;">{% for i in range(5) %}<span class="check" style="width:1.6em;height:1.6em;"></span>{% endfor %}</div>
      <div class="small muted" style="display:flex;justify-content:space-between;margin-top:.3em;"><span>low</span><span>great</span></div>
    </div>
  </div>
  {{ footer(content.title, false, content.affirmations[loop.index0 % content.affirmations|length]) }}
</section>
{% if loop.index % 7 == 0 %}
<section class="page">
  {{ header(style, 'Week ' ~ (loop.index // 7) ~ ' check-in', 'Pause and look back') }}
  <div style="display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:1fr;gap:.8em;flex:1;min-height:0;">
    {{ box('What went well', 5) }}{{ box('What was hard', 5) }}{{ box('What I learned', 5) }}{{ box('What I will carry forward', 5) }}
  </div>
  {{ footer(content.title) }}
</section>
{% endif %}
{% endfor %}
