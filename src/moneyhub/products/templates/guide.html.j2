{% from '_macros.html.j2' import header, lines, box, footer, cover_page %}
{{ cover_page(style, page, content.title, content.subtitle, content.tagline, [content.chapters|length ~ ' chapters', 'Action steps', 'Printable PDF']) }}

<section class="page">
  {{ header(style, 'Contents', content.title) }}
  <p style="font-size:1.05em;max-width:34em;">{{ content.intro }}</p>
  <div style="margin-top:1em;">
    {% for ch in content.chapters %}
    <div style="display:flex;align-items:baseline;border-bottom:1px solid var(--line);padding:.55em 0;">
      <b class="h" style="font-size:1.4em;color:var(--accent);width:1.6em;">{{ loop.index }}</b><span style="font-size:1.05em;">{{ ch.title }}</span></div>
    {% endfor %}
  </div>
  {% if content.disclaimer %}<div class="card soft" style="margin-top:auto;font-size:.8em;"><div class="label">Please note</div>{{ content.disclaimer }}</div>{% endif %}
  {{ footer(content.title) }}
</section>

{% for ch in content.chapters %}
<section class="page">
  {{ header(style, 'Chapter ' ~ loop.index, ch.title) }}
  <p style="font-size:1.05em;max-width:36em;">{{ ch.intro }}</p>
  <div class="label" style="margin:.6em 0 .4em;">What to know</div>
  {% for t in ch.tips %}<div style="display:flex;margin-bottom:.55em;"><span style="color:var(--accent);font-weight:700;width:1.4em;flex:none;">&bull;</span><span>{{ t }}</span></div>{% endfor %}
  {% if ch.callout %}<div class="card soft" style="margin-top:.6em;"><div class="label">Remember</div>{{ ch.callout }}</div>{% endif %}
  <div class="card" style="margin-top:.9em;flex:1;min-height:0;"><div class="label">Your action steps</div>
    {% for a in ch.action_steps %}<div class="cl-item"><span class="sq"></span><span>{{ a }}</span></div>{% endfor %}
    <div class="label" style="margin-top:.8em;">Notes</div>{{ lines(4) }}</div>
  {{ footer(content.title) }}
</section>
{% endfor %}
