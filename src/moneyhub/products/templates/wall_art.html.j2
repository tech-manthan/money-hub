{% for d in designs %}
{% set b = d.b %}
<section class="page art" style="padding:0;background:{{ d.bg }};color:{{ d.fg }};">
  {% if d.ai_bg %}<img src="{{ d.ai_bg }}" style="position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;">
  <div style="position:absolute;left:0;top:0;right:0;bottom:0;background:{{ d.bg }};opacity:.55;"></div>{% endif %}
  {% if b.frame %}<div class="frame" style="border-color:{{ d.fg }};"></div>{% endif %}
  {% if b.motif %}<div class="motif" style="left:{{ b.motif.l }}%;width:{{ b.motif.w }}%;top:{{ b.motif.t }}%;height:{{ b.motif.h }}%;">{{ d.svg|safe }}</div>{% endif %}
  {% if b.rule %}<div class="rule" style="top:{{ b.rule }}%;background:{{ d.fg }};"></div>{% endif %}
  <div class="txt" style="left:{{ b.margin }}%;right:{{ b.margin }}%;top:{{ d.text_top }}%;text-align:{{ b.align }};font-size:{{ d.fs }}em;">{{ d.text }}</div>
  {% if d.small and b.small %}<div class="small-t" style="left:{{ b.margin }}%;right:{{ b.margin }}%;bottom:{{ b.small }}%;">{{ d.small }}</div>{% endif %}
</section>
{% endfor %}
