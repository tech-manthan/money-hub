{% from '_macros.html.j2' import header, lines, box, footer, cover_page %}
{{ cover_page(style, page, content.title, content.subtitle, content.tagline, [content.sheets|length ~ ' worksheets', 'Answer key included', content.level]) }}

{% for sh in content.sheets %}
<section class="page">
  {{ header(style, sh.title, content.level) }}
  {% if spec.name_line %}<div style="display:flex;justify-content:space-between;font-size:.8em;margin-bottom:.8em;"><span>Name: ______________________</span><span>Date: ______________</span></div>{% endif %}
  {% if spec.directions == 'card' %}<div class="card soft" style="margin-bottom:.9em;"><div class="label">Directions</div>{{ sh.instructions }}</div>
  {% else %}<p style="margin:0 0 .9em;"><b style="color:var(--accent);">Directions:</b> {{ sh.instructions }}</p>{% endif %}
  <div class="{{ 'ws-grid' if spec.columns == 2 else '' }}" style="flex:1;{% if spec.columns == 1 %}display:flex;flex-direction:column;gap:.55em;{% endif %}min-height:0;">
    {% for q in sh['items'] %}
    <div class="ws-q {{ 'card' if spec.cards else 'plain' }}" style="{% if spec.columns == 1 %}flex:1;{% endif %}flex-direction:row;align-items:flex-start;display:flex;">
      {% if spec.numbering == 'circle' %}<div style="flex:none;width:1.8em;height:1.8em;border-radius:50%;background:var(--accent);color:var(--accent-ink);text-align:center;line-height:1.8em;font-weight:700;margin-right:.7em;">{{ loop.index }}</div>
      {% else %}<div style="flex:none;width:1.7em;font-weight:700;color:var(--accent);">{{ loop.index }}.</div>{% endif %}
      <div style="flex:1;display:flex;flex-direction:column;height:100%;min-width:0;">
        <div style="font-weight:500;">{{ q.question }}</div>
        {% if q.choices %}
        <div style="display:flex;{% if spec.choices == 'stacked' %}flex-direction:column;gap:.15em;{% else %}flex-wrap:wrap;gap:.3em 1.4em;{% endif %}margin-top:.35em;font-size:.9em;">{% for c in q.choices %}<span><i class="sq"></i> {{ c }}</span>{% endfor %}</div>
        {% else %}<div style="flex:1;margin-top:.2em;">{{ lines(spec.answer_lines) }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {{ footer(content.title, false, content.topic) }}
</section>
{% endfor %}

<section class="page">
  {{ header(style, 'Answer key', 'For the teacher or parent') }}
  <div style="columns:2;column-gap:2em;font-size:.9em;">
    {% for sh in content.sheets %}
    <div style="break-inside:avoid;margin-bottom:1em;">
      <div class="label">{{ sh.title }}</div>
      {% for q in sh['items'] %}<div style="margin:.15em 0;"><b>{{ loop.index }}.</b> {{ q.answer }}</div>{% endfor %}
    </div>
    {% endfor %}
  </div>
  {{ footer(content.title) }}
</section>
